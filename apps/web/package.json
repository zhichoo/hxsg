{
  "name": "@hxsg/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:mapp": "tsc --noEmit && vite build --config vite.config.mapp.ts && node scripts/package-mapp.mjs",
    "build:mapp:debug": "MINI_APP_DEBUG=1 pnpm run build:mapp",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@discourse-mini-app/sdk": "workspace:*",
    "@hxsg/shared": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.7.2",
    "vite": "^6.2.0"
  }
}
