# ============================================================
# 幻想三国 · 腾讯云上海 + Cloudflare Tunnel 双环境配置模板
# 复制为同目录 .env 后填写实际值（.env 已被 .gitignore 忽略）
# ============================================================

# Cloudflare Zero Trust Tunnel Token（在 CF Zero Trust -> Tunnels 创建后获取）
CF_TUNNEL_TOKEN=replace-with-your-cloudflare-tunnel-token

# 独立 Web 鉴权密钥（建议用 openssl rand -hex 32 分别生成）
HXSG_SECRET_PROD=replace-with-random-hex-prod
HXSG_SECRET_SANDBOX=replace-with-random-hex-sandbox

# ============================================================
# LINUX.DO 微应用（Discourse Mini App）鉴权配置
# 留空 HXSG_MAPP_APP_ID 时仍可作为独立 Web 正常运行
# ============================================================
HXSG_MAPP_ISSUER=https://linux.do
HXSG_MAPP_APP_ID=
HXSG_MAPP_AUDIENCE_PROD=https://hxsg.example.com
HXSG_MAPP_AUDIENCE_SANDBOX=https://hxsg-sandbox.example.com

# 可选（大陆机房兜底）：如果腾讯云上海直连 linux.do/mini-app-api/jwks 超时，
# 任选其一：
# 1) 指向你海外可信反代/Worker 转发的 JWKS 地址：
HXSG_MAPP_JWKS_URL=
# 2) 或直接粘贴从本机 curl https://linux.do/mini-app-api/jwks 拿到的单条 JWK JSON：
HXSG_MAPP_PUBLIC_KEY=

# 开启严格 CORS（允许 linux.do 与自身站点）
HXSG_CORS_STRICT=1

# 可选：设为 1 可关闭独立 Web 匿名注册（仅允许 LINUX.DO 社区账号进入，防脚本广告）
HXSG_DISABLE_PUBLIC_REGISTER=0
